<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_updater_profile_list" model="ir.ui.view">
        <field name="name">updater.profile.list</field>
        <field name="model">updater.profile</field>
        <field name="arch" type="xml">
            <list string="Updater Profiles">
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_updater_profile_form" model="ir.ui.view">
        <field name="name">updater.profile.form</field>
        <field name="model">updater.profile</field>
        <field name="arch" type="xml">
            <form string="Updater Profile">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Backend Dev Modules"/>
                        </h1>
                    </div>

                    <notebook>
                        <page string="Modules" name="modules">
                            <field name="module_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="module_id" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_updater_profile" model="ir.actions.act_window">
        <field name="name">Updater Profiles</field>
        <field name="res_model">updater.profile</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>