<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fast_devtools</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                
                <app id="fast_devtools" name="fast_devtools" string="Fast DevTools" groups="base.group_system">
                    
                    <block title="Debugger" name="fast_devtools_debugger">
                        <setting help="Enable standard debug mode (?debug=1)">
                            <field name="enable_debug_1"/>
                        </setting>
                        <setting help="Enable assets debug mode (?debug=assets)">
                            <field name="enable_debug_assets"/>
                        </setting>
                        <setting help="Enable tests debug mode (?debug=assets,tests)">
                            <field name="enable_debug_tests"/>
                        </setting>
                    </block>

                    <block title="Updater" name="fast_devtools_updater">
                        <setting help="Show module updater in the top systray">
                            <field name="enable_systray_updater"/>
                        </setting>

                        <setting help="Select the profile to execute when clicking the Update button" invisible="not enable_systray_updater">
                            <field name="updater_profile_ids" 
                                    widget="many2many_tags" 
                                    options="{'no_create': True, 'no_create_edit': True}" 
                                    placeholder="Select profiles..."/>
                            <div class="mt-2">
                                <button type="action" name="%(fast_devtools.action_updater_profile)d" string="Manage Profiles" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>