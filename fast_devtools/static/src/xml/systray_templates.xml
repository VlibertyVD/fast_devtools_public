<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <!-- Updater Icon (Unchanged, kept for completion) -->
    <t t-name="fast_devtools.SystrayUpdater" owl="1">
        <div t-if="isVisible" class="o_systray_item d-flex align-items-center" t-on-click="onUpdateClick">
            <a role="button" class="nav-link px-2 d-flex align-items-center text-white">
                <i class="fa fa-refresh me-1 text-white"/>
                <span>Update</span>
            </a>
        </div>
    </t>

    <!-- Debug Toggle / Dropdown -->
    <t t-name="fast_devtools.SystrayDebug" owl="1">
        <div t-if="activeModes.length > 0" class="o_systray_item d-flex align-items-center" style="position: relative;">
            
            <!-- Main Button -->
            <a role="button" class="nav-link px-2 d-flex align-items-center text-white" t-on-click="toggleAction">
                <i t-attf-class="fa {{ currentDebug ? 'fa-cogs text-success' : 'fa-cogs text-white' }} me-1"/>
                <span>Debug</span>
                <i t-if="isMultiple" class="fa fa-caret-down ms-1 text-white"/>
            </a>
            
            <!-- Dropdown Menu -->
            <div t-if="isMultiple and state.isOpen" class="dropdown-menu show" style="position: absolute; top: 100%; right: 0;">
                <t t-foreach="activeModes" t-as="mode" t-key="mode.id">
                    <a role="button" class="dropdown-item d-flex align-items-center" t-on-click="() => this.setDebug(mode.val)">
                        <i t-attf-class="fa fa-fw {{ currentDebug === mode.val ? 'fa-check text-success' : '' }} me-2"/>
                        <t t-esc="mode.label"/>
                    </a>
                </t>
            </div>

        </div>
    </t>

</templates>